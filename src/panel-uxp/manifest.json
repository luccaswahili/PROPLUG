{
  "id": "com.proplugs.lookmatch.panel",
  "name": "LookMatch",
  "version": "0.5.1",
  "manifestVersion": 5,
  "main": "index.html",
  "host": { "app": "premierepro", "minVersion": "25.0" },
  "requiredPermissions": { "localFileSystem": "fullAccess" },
  "entrypoints": [
    {
      "type": "panel",
      "id": "lookmatchPanel",
      "label": { "default": "LookMatch" },
