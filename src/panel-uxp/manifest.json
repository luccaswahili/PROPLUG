{
  "id": "com.proplugs.lookmatch.panel",
  "name": "Komodo",
  "version": "1.0.0",
  "manifestVersion": 5,
  "main": "index.html",
  "host": { "app": "premierepro", "minVersion": "25.0" },
  "requiredPermissions": { "localFileSystem": "fullAccess" },
  "entrypoints": [
    {
      "type": "panel",
      "id": "lookmatchPanel",
      "label": { "default": "Komodo" },
